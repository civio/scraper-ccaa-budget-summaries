#!/usr/bin/env ruby
# Command line interface to the CCAA budget summary scraper.
#
#   bin/ccaa parse budget    turn staging_budget/ into budget.sorted.csv
#   bin/ccaa parse actual    turn staging_actual/ into actual.sorted.csv
#
# 'budget' is what each region approved for the year, 'actual' what it reported spending.

require 'optparse'

require_relative '../lib/dataset'
require_relative '../lib/summary_parser'

COMMANDS = %w[parse].freeze

options = {}
parser = OptionParser.new do |opts|
  opts.banner = "Usage: bin/ccaa {#{COMMANDS.join('|')}} {#{Dataset::NAMES.join('|')}} [options]"
  opts.separator ''
  opts.separator '  parse     Turn the staged pages into the published CSV'
  opts.separator ''

  opts.on('-i', '--input PATH',
          'Folder holding the staged pages',
          '(default: staging_DATASET)') { |v| options[:input] = v }
  opts.on('-o', '--output PATH',
          'CSV to write (default: DATASET.sorted.csv)') { |v| options[:output] = v }
  opts.on('-h', '--help', 'Show this message') do
    puts opts
    exit
  end
end
parser.parse!

command, name = ARGV
abort parser.help if command.nil? || name.nil?
abort "Unknown command '#{command}'.\n\n#{parser.help}" unless COMMANDS.include?(command)

dataset = Dataset[name]
abort "Unknown dataset '#{name}', expected #{Dataset::NAMES.join(' or ')}.\n\n#{parser.help}" if dataset.nil?

root = File.expand_path('..', __dir__)
input_path = options[:input] || File.join(root, dataset.staging_folder)
output_path = options[:output] || File.join(root, dataset.output_file)

unless File.directory?(input_path)
  abort "Can't find the staged pages for #{dataset.name}. Expected #{input_path}/, " \
        'or pass --input PATH.'
end

puts "Parsing the #{dataset.name} summaries in #{input_path}"
rows = SummaryParser.new(input_path, output_path).run
puts "Wrote #{rows} rows to #{output_path}"
