source 'https://rubygems.org'

ruby '>= 3.2'

# Downloading the summary pages from the ministry site, which only serves them to a caller
# that has visited the landing page first and kept the session cookie
gem 'mechanize'

# Parsing them. It arrives with mechanize anyway, but parse.rb requires it directly, so it
# is a direct dependency of this project and not mechanize's business.
gem 'nokogiri'

# Command line options
gem 'optimist'

# A bundled gem since Ruby 3.4, so it has to be declared explicitly
gem 'csv'
